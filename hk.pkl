amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

hooks {
    ["check"] {
        steps {
            ["gitleaks"] {
                check = "sh scripts/gitleaks-check repository"
            }
        }
    }
    ["pre-commit"] {
        stash = "git"
        steps {
            ["gitleaks"] {
                check = "sh scripts/gitleaks-check staged"
            }
        }
    }
    ["pre-push"] {
        steps {
            ["gitleaks"] {
                check = "sh scripts/gitleaks-check commits"
            }
        }
    }
}
